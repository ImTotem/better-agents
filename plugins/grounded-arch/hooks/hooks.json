{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.sh\" pre-write"}]
      },
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.sh\" pre-bash"}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.sh\" stop"}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.sh\" user-prompt"}]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/hook.sh\" session-start"}]
      }
    ]
  }
}
