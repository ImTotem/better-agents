#!/bin/bash
# ga: grounded-arch core CLI dispatcher.  ga [--root DIR] <sub> [args]
# Sources core/lib/*.sh, then calls cmd_<sub> (dashes in <sub> become underscores).

# Hooks and the MCP server run ga outside the OS sandbox (spec 5.5, P28): it runs only system tools.
# The caller's PATH is kept as GA_USER_PATH for the verifier runners and the sandboxed build check.
GA_USER_PATH=${GA_USER_PATH:-$PATH}
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export GA_USER_PATH PATH
_d=${0%/*}
[ "$_d" = "$0" ] && _d=.
GA_CORE=$(cd -P "$_d/.." && pwd)
unset _d
. "$GA_CORE/lib/common.sh"
for _f in "$GA_CORE"/lib/*.sh; do
  case "$_f" in */common.sh) continue ;; esac
  [ -f "$_f" ] && . "$_f"
done
unset _f

ga_usage() {
  cat <<'EOF'
사용법: ga [--root DIR] <명령> [인자...]
  version    버전 출력
EOF
}

root_arg=""
GA_ROOT_EXPLICIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --root)
      [ $# -ge 2 ] || { ga_usage >&2; exit 2; }
      root_arg=$2
      GA_ROOT_EXPLICIT=1
      shift 2
      ;;
    --root=*) root_arg=${1#--root=}; GA_ROOT_EXPLICIT=1; shift ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then ga_usage >&2; exit 2; fi
sub=$1
shift

if [ -n "$root_arg" ]; then
  GA_ROOT=$(ga_canon "$root_arg") || exit 2
elif [ -n "${GA_ROOT:-}" ]; then
  GA_ROOT=$(ga_canon "$GA_ROOT") || exit 2
else
  # P15: from a hook, the design is the one of the harness's project root, not of the drifting cwd.
  GA_ROOT=$(ga_find_root "$(ga_session_dir)") || GA_ROOT=""
fi
export GA_ROOT

fn="cmd_$(echo "$sub" | tr - _)"
case "$fn" in
  *[!a-zA-Z0-9_]*) echo "ga: 알 수 없는 명령: $sub" >&2; ga_usage >&2; exit 2 ;;
esac
if [ "$(type -t "$fn")" != function ]; then
  echo "ga: 알 수 없는 명령: $sub" >&2
  ga_usage >&2
  exit 2
fi
GA_SUB=$sub # names the MCP tool in error messages (ga_mcp_hint)
case "$sub" in
  # P3: the commands that change the design state refuse while the state fingerprint mismatches.
  # A shell inside the OS sandbox cannot write the state folder: say which MCP tool to use, at once.
  add | update | ask | resolve | render | verify | enforce | dispute) ga_fp_guard; ga_need_writable_state ;;
esac
"$fn" "$@"
